# Copy to .env (git-ignored) and fill in. Never commit real values.
# local or demo allow DEMO_STUBS and DEV_JWKS_FILE; staging and production refuse them.
APP_ENV=local
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Local Postgres from docker compose.
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
# The API connects as marketing_app (not the owner), so row-level security applies to it.
DATABASE_URL=postgresql+asyncpg://marketing_app:change-me-app@127.0.0.1:5432/marketing
# Migrations and seeding run as the database owner.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:change-me-owner@127.0.0.1:5432/marketing
TEST_DATABASE_URL=postgresql+asyncpg://marketing_app:change-me-app@127.0.0.1:5432/marketing_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:change-me-owner@127.0.0.1:5432/marketing_test

# Cognito (from Bhushan). The issuer and JWKS URL are derived from these two.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
# Comma-separated app client IDs allowed to call the API.
COGNITO_CLIENT_IDS=replace-with-app-client-id
REQUIRED_SCOPE=marketing/api

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Simulated validation, generation, assets and export for frontend integration (local/demo only).
# Leave false in staging and production: the endpoints then answer 501 until D2-D5 ship.
DEMO_STUBS=false
# Base URL the frontend reaches this API on; used for placeholder image links.
DEMO_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Locally signed tokens until Cognito exists (local/demo only). Created by
# `uv run python -m scripts.dev_token init`; leave empty to use Cognito's keys.
DEV_JWKS_FILE=
