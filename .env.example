# Copy to .env (git-ignored) and fill in. Never commit real values.
# local or demo allow DEMO_STUBS, DEV_JWKS_FILE and EMBEDDING_MODE=simulator; staging and
# production refuse them.
APP_ENV=local
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Local Postgres from docker compose.
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
# The connector worker connects as marketing_worker: RLS applies, and only it can lease outbox
# events or touch provider_spend.
WORKER_DB_PASSWORD=change-me-worker
# The API connects as marketing_app (not the owner), so row-level security applies to it.
DATABASE_URL=postgresql+asyncpg://marketing_app:change-me-app@127.0.0.1:5432/marketing
# secret: the worker's database URL (required by the worker, which refuses to start without it)
WORKER_DATABASE_URL=postgresql+asyncpg://marketing_worker:change-me-worker@127.0.0.1:5432/marketing
# Migrations and seeding run as the database owner.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:change-me-owner@127.0.0.1:5432/marketing
TEST_DATABASE_URL=postgresql+asyncpg://marketing_app:change-me-app@127.0.0.1:5432/marketing_test
TEST_WORKER_DATABASE_URL=postgresql+asyncpg://marketing_worker:change-me-worker@127.0.0.1:5432/marketing_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:change-me-owner@127.0.0.1:5432/marketing_test

# Cognito user pool (staging pool from Prabhu). The issuer and JWKS URL are derived from these two;
# the Hosted UI domain is only for the web app's login page.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# Comma-separated app client IDs allowed to call the API.
COGNITO_CLIENT_IDS=replace-with-app-client-id
REQUIRED_SCOPE=marketing/api

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Simulated validation, generation, assets and export for frontend integration (local/demo only).
# Leave false in staging and production: generation then uses the real jobs below, and image
# validation, assets, media and export answer 501 until D3-D5 ship.
DEMO_STUBS=false
# Base URL the frontend reaches this API on; used for placeholder image links.
DEMO_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Locally signed tokens for offline work without Cognito (local/demo only). Created by
# `uv run python -m scripts.dev_token init`; leave empty to use Cognito's keys.
DEV_JWKS_FILE=

# ---- Image generation (NRC-6, NRC-10)
# setting: simulator | live. Live never falls back to the simulator and refuses to start without keys.
GENERATION_MODE=simulator
# settings: per-tenant admission limits (the credit ceiling is per rolling 24 hours)
GENERATION_MAX_ACTIVE_JOBS_PER_TENANT=2
GENERATION_DAILY_CREDIT_CEILING_PER_TENANT=20
GENERATION_CREDITS_PER_IMAGE=1
# setting: a job whose provider cost estimate (USD) is above this fails before submitting
GENERATION_MAX_COST_USD_PER_IMAGE=0.10
# setting: cap on provider spend (USD) across all tenants; past it jobs fail BUDGET_EXHAUSTED
GENERATION_GLOBAL_BUDGET_USD=40
# setting: failed processing attempts per job event (crash, expired lease, no handler) before the
# worker gives up; polls and retryable provider errors are bounded by the deadline instead
GENERATION_MAX_ATTEMPTS=3
# setting: seconds from acceptance until a job is given up
GENERATION_DEADLINE_SECONDS=900
# setting: seconds an accepted job may stay in progress at the provider past its deadline before it is parked as UNKNOWN
GENERATION_ACCEPTED_GRACE_SECONDS=3600
# setting: generations one provider may run at once across all tenants and workers (jobs past it wait in their current state)
GENERATION_MAX_IN_FLIGHT_PER_PROVIDER=4
# settings: per-provider circuit breaker in each worker: transient estimate/submit failures in a
# row before new requests pause, and how long they pause (seconds)
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_OPEN_SECONDS=60
# setting: seconds a cancel request waits for a locked job row before answering a retryable 503
JOB_CANCEL_LOCK_TIMEOUT_SECONDS=2
# settings: connector worker. Idle poll interval; lease per event (5-600, must exceed
# HTTP_TIMEOUT_SECONDS); events per iteration; retry delay for a job kind without a handler;
# exponential retry/poll backoff (base doubles up to max, with jitter)
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_MAX_EVENTS_PER_RUN=10
WORKER_NO_HANDLER_RETRY_SECONDS=60
WORKER_BACKOFF_BASE_SECONDS=2
WORKER_BACKOFF_MAX_SECONDS=60
# setting: Higgsfield API base URL and the pinned image model path (from operations)
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_MODEL=
# setting: output resolution sent to Higgsfield, 720p or 1080p
HIGGSFIELD_RESOLUTION=1080p
# secret: Higgsfield key as "<key-id>:<key-secret>" (required only when GENERATION_MODE=live).
# local: put it in .env.local (git-ignored), not here or in .env
HIGGSFIELD_API_KEY=
# setting: staging/production only. AWS Secrets Manager secret holding the key (JSON entry
# HIGGSFIELD_API_KEY), read by the worker at startup through its IAM role
# when HIGGSFIELD_API_KEY is not set. Example: nrc/stg/higgsfield
HIGGSFIELD_SECRET_ID=
# setting: comma-separated hosts generated images may be downloaded from. Output on any other
# host is never fetched; the worker logs the host at ERROR and retries until it expires.
HIGGSFIELD_OUTPUT_HOSTS=
# setting: seconds for downloading one generated image (the worker also caps it at half its lease)
PROVIDER_OUTPUT_FETCH_TIMEOUT_SECONDS=30
# setting: seconds a completed output is assumed to live when the provider gives no expiry
PROVIDER_OUTPUT_RETENTION_FALLBACK_SECONDS=604800

# ---- Media storage (NRC-3). Local S3 is SeaweedFS from docker compose.
# setting: bucket name (local: nrc-local-media; staging and production: set by ops)
AWS_S3_BUCKET=nrc-local-media
AWS_REGION=us-east-1
# setting, local only (never set on servers): SeaweedFS endpoint, path-style addressing and the
# local profile holding the SeaweedFS-only credentials from docker/seaweedfs-s3.json
AWS_ENDPOINT_URL_S3=http://127.0.0.1:8333
S3_FORCE_PATH_STYLE=true
AWS_PROFILE=nrc-local
# settings: S3 client timeouts (seconds) and retries after the first attempt
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30
S3_MAX_RETRIES=3
# settings: largest generated image accepted (bytes and pixels)
MAX_GENERATED_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
# setting: lifetime of a download URL from GET /assets/{id}, in seconds (60-3600)
ASSET_URL_TTL_SECONDS=900
# settings: policy retrieval (NRC-5) graph walk limits: hops from each selected rule (1-10), and
# evidence nodes plus exception entries per context manifest (10-2000); hitting either is
# recorded as TRAVERSAL_TRUNCATED
POLICY_RETRIEVAL_MAX_HOPS=3
POLICY_RETRIEVAL_MAX_NODES=200
# settings: policy search (NRC-5): matches kept per statement (1-50), and statements searched per
# request (1-200; more are recorded as STATEMENTS_TRUNCATED)
POLICY_RETRIEVAL_TOP_K=5
POLICY_RETRIEVAL_MAX_STATEMENTS=50
# setting: limit in seconds on each database statement while building the policy context inside
# a validation request (0.001-30, below DB_TIMEOUT_SECONDS); a run that hits it is stored as
# NEEDS_REVIEW, never PASS
POLICY_CONTEXT_TIMEOUT_SECONDS=5
# setting: policy embeddings (NRC-5): off (no vectors, lexical search only; the default),
# simulator (meaningless vectors, local and demo only; refused in staging and production) or live
# (Amazon Bedrock, never falls back to the simulator)
EMBEDDING_MODE=simulator
# setting: required when EMBEDDING_MODE=live; one of amazon.titan-embed-text-v2:0,
# cohere.embed-multilingual-v3, cohere.embed-v4:0 (the models the evaluation compares)
BEDROCK_EMBEDDING_MODEL_ID=
# settings: Bedrock client timeout in seconds (connect and read) and retries after the first
# attempt; the region is AWS_REGION and access comes from the IAM role, no keys
BEDROCK_TIMEOUT_SECONDS=10
BEDROCK_MAX_RETRIES=3
# setting: text judge for policy validation (NRC-7): off (no model judge; the default), simulator
# (labelled SIMULATED answers, local and demo only; refused in staging and production) or live
# (Amazon Bedrock, never falls back to the simulator)
VALIDATION_MODEL_MODE=off
# setting: required when VALIDATION_MODEL_MODE=live; one of the candidate model ids in
# app/services/providers/text_judge.py (SUPPORTED_BEDROCK_JUDGE_MODEL_IDS)
BEDROCK_VALIDATION_MODEL_ID=
# setting: judge call timeout in seconds, connect and read (1-120). In live mode one call may
# take this times (BEDROCK_MAX_RETRIES + 1), which must be below WORKER_LEASE_SECONDS or the
# worker refuses to start (e.g. 10 x 4 = 40 < 60)
VALIDATION_MODEL_TIMEOUT_SECONDS=30
# setting: most tokens the judge may answer with (256-8000)
VALIDATION_MODEL_MAX_OUTPUT_TOKENS=2000
# setting: judge calls per validation when its answer fails verification (1-3)
VALIDATION_MODEL_MAX_ATTEMPTS=2
# setting: validation job tries after model throttling or timeouts (1-20); then the run is
# stored as needing review
VALIDATION_JOB_MAX_ATTEMPTS=5
# setting: seconds a validation job may take in all (60-86400); then it needs review
VALIDATION_JOB_DEADLINE_SECONDS=600
# setting: brief and caption validations queued or running at once per tenant (1-200); more get
# 429 VALIDATION_LIMIT_REACHED
VALIDATION_MAX_ACTIVE_JOBS_PER_TENANT=20

# ---- Client uploads (NRC-3)
# setting: lifetime of a presigned upload URL, in seconds (60-900; the S3 cap is 15 minutes)
UPLOAD_URL_TTL_SECONDS=600
# setting: largest client image accepted, in bytes (1024-52428800)
UPLOAD_IMAGE_MAX_BYTES=20971520
# setting: accepted image MIME types, comma-separated (image/png and image/jpeg are supported)
UPLOAD_IMAGE_TYPES=image/png,image/jpeg
# setting: uploads one tenant may have in progress (in quarantine or inspection, or pending with a
# valid upload URL); more get 429 UPLOAD_LIMIT_REACHED (1-1000)
UPLOAD_MAX_PENDING_PER_TENANT=20
# setting: failed inspection attempts before an upload is rejected as INSPECTION_FAILED (1-10)
MEDIA_INSPECTION_MAX_ATTEMPTS=3
# setting: seconds temporary scanner/storage outages may delay an inspection before the upload is
# rejected as INSPECTION_FAILED (600-604800)
MEDIA_INSPECTION_RETRY_WINDOW_SECONDS=86400
# setting, local/demo only: "simulator" labels every scan verdict as simulated. Staging and
# production must leave this unset (live, the default); live needs a real scanner, not chosen yet.
MALWARE_SCAN_MODE=simulator
# setting: longest one malware scan may take before the upload is retried later, in seconds
# (10-3600)
MALWARE_SCAN_TIMEOUT_SECONDS=300
