# Copy to .env (git-ignored) and fill in. Never commit real values.
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Local Postgres from docker compose.
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
# The connector worker connects as marketing_worker: RLS applies, and only it can lease outbox
# events or touch provider_spend.
WORKER_DB_PASSWORD=change-me-worker
# The API connects as marketing_app (not the owner), so row-level security applies to it.
DATABASE_URL=postgresql+asyncpg://marketing_app:change-me-app@127.0.0.1:5432/marketing
# secret: the worker's database URL (required by the worker, which refuses to start without it)
WORKER_DATABASE_URL=postgresql+asyncpg://marketing_worker:change-me-worker@127.0.0.1:5432/marketing
# Migrations and seeding run as the database owner.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:change-me-owner@127.0.0.1:5432/marketing
TEST_DATABASE_URL=postgresql+asyncpg://marketing_app:change-me-app@127.0.0.1:5432/marketing_test
TEST_WORKER_DATABASE_URL=postgresql+asyncpg://marketing_worker:change-me-worker@127.0.0.1:5432/marketing_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:change-me-owner@127.0.0.1:5432/marketing_test

# Cognito (from Bhushan). The issuer and JWKS URL are derived from these two.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
# Comma-separated app client IDs allowed to call the API.
COGNITO_CLIENT_IDS=replace-with-app-client-id
REQUIRED_SCOPE=marketing/api

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# ---- Image generation (NRC-6, NRC-10)
# setting: simulator | live. Live never falls back to the simulator and refuses to start without keys.
GENERATION_MODE=simulator
# settings: per-tenant admission limits and job bounds
GENERATION_MAX_ACTIVE_JOBS_PER_TENANT=2
GENERATION_DAILY_CREDIT_CEILING_PER_TENANT=20
GENERATION_CREDITS_PER_IMAGE=1
# setting: a job whose provider cost estimate (USD) is above this fails before submitting
GENERATION_MAX_COST_USD_PER_IMAGE=0.10
# setting: cap on provider spend (USD) across all tenants; past it jobs fail BUDGET_EXHAUSTED
GENERATION_GLOBAL_BUDGET_USD=40
# setting: failed processing attempts per job event (crash, expired lease, no handler) before the
# worker gives up; polls and retryable provider errors are bounded by the deadline instead
GENERATION_MAX_ATTEMPTS=3
GENERATION_DEADLINE_SECONDS=900
# settings: connector worker throughput and retry delay for a job kind without a handler
WORKER_MAX_EVENTS_PER_RUN=10
WORKER_NO_HANDLER_RETRY_SECONDS=60
# setting: Higgsfield API base URL and the pinned image model path (from operations)
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_MODEL=
# secret: Higgsfield key as "<key-id>:<key-secret>" (required only when GENERATION_MODE=live).
# local: put it in .env.local (git-ignored), not here or in .env
HIGGSFIELD_API_KEY=
# setting: staging/production only. AWS Secrets Manager secret holding the key (JSON entry
# HIGGSFIELD_API_KEY), read by the worker at startup through its IAM role
# when HIGGSFIELD_API_KEY is not set. Example: nrc/stg/higgsfield
HIGGSFIELD_SECRET_ID=
# setting: comma-separated hosts generated images may be downloaded from
HIGGSFIELD_OUTPUT_HOSTS=
# setting: seconds for downloading one generated image (the worker also caps it at half its lease)
PROVIDER_OUTPUT_FETCH_TIMEOUT_SECONDS=30

# ---- Media storage (NRC-3). Local S3 is SeaweedFS from docker compose.
# setting: bucket name (local: nrc-local-media; staging: nrc-staging-media in the NRC AWS account)
AWS_S3_BUCKET=nrc-local-media
AWS_REGION=us-east-1
# setting, local only (never set on servers): SeaweedFS endpoint, path-style addressing and the
# local profile holding the SeaweedFS-only credentials from docker/seaweedfs-s3.json
AWS_ENDPOINT_URL_S3=http://127.0.0.1:8333
S3_FORCE_PATH_STYLE=true
AWS_PROFILE=nrc-local
# settings: S3 client timeouts (seconds) and retries after the first attempt
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30
S3_MAX_RETRIES=3
# settings: largest generated image accepted (bytes and pixels)
MAX_GENERATED_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
# setting: lifetime of a download URL from GET /assets/{id}, in seconds (60-3600)
ASSET_URL_TTL_SECONDS=900
